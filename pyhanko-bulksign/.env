# Active config: TESTING -- software mode, no DSC token needed.
# (Seal-image appearance below stays active in both modes.)
#
# Switch modes by swapping which block is commented: for PRODUCTION, comment the
# TESTING block and uncomment the PRODUCTION block (set SIGNER_MODE=pkcs11).

# ===== TESTING (software, no token) -- active ==============================
# The app auto-creates a self-signed test-cert.p12 on first START.
SIGNER_MODE=software
SIGNER_P12_PATH=test-cert.p12
SIGNER_P12_PASSWORD=test

# ===== PRODUCTION (real DSC token) -- uncomment to use =====================
# SIGNER_MODE=pkcs11
# Vendor PKCS#11 module for the Hypersecu HYP2003 token (OpenSC does not work).
# PKCS11_MODULE_PATH=/home/bhlp0149/Downloads/HYP2003-Linux-x86_64/redist/libcastle_v2.so.1.0.0
# Object labels read from THIS token via: pkcs11-tool --module <so> -O
# PKCS11_CERT_LABEL=3dec5b76-5690-4b2e-89fd-9a3e426e88b8
# PKCS11_KEY_LABEL=3dec5b76-5690-4b2e-89fd-9a3e426e88b8

# --- appearance -------------------------------------------------------------
# Seal/logo drawn behind the signature text.
# SIGN_STAMP_TEXT=Digitally signed by %(signer)s\nDate: %(ts)s
SIGN_STAMP_IMAGE=/home/bhlp0149/Desktop/pucardotorg/dristi-solutions/pyhanko-bulksign/court-seal.png
SIGN_STAMP_OPACITY=0.3

# --- service ----------------------------------------------------------------
HOST=127.0.0.1
PORT=1620
CORS_ALLOW_ORIGINS=*
