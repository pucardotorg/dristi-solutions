# OnCourts Bulk Sign settings. Nothing here is machine-specific: copy this folder
# to any computer as-is.
#
# Signing mode is chosen in the app window ("DSC token" or "Test mode").
# This only sets which option is pre-selected: pkcs11 = DSC token, software = Test.
SIGNER_MODE=pkcs11

# ===== DSC token =============================================================
# Token library (PKCS#11 module): LEAVE BLANK to find it automatically --
#   1. a .dll (Windows) / .so (Linux) copied into THIS folder, next to the exe
#   2. the token vendor's standard install location (driver already installed)
# Set it only to force a specific file (bare filename = in this folder, or a full
# path). OpenSC does NOT work for Indian-CA tokens; use the vendor's library.
PKCS11_MODULE_PATH=
# Cert/key labels: LEAVE BLANK to auto-detect a single-identity token (the app shows
# the detected label). Set explicitly only if the token holds several certificates.
PKCS11_CERT_LABEL=
PKCS11_KEY_LABEL=

# ===== Test mode ============================================================
# The app auto-creates this self-signed test certificate on first START.
SIGNER_P12_PATH=test-cert.p12
SIGNER_P12_PASSWORD=test

# --- appearance -------------------------------------------------------------
# Seal/logo drawn behind the signature text. Keep court-seal.png in THIS folder
# (next to .env / the exe); a bare filename is resolved there automatically.
# SIGN_STAMP_TEXT=Digitally signed by %(signer)s\nDate: %(ts)s
SIGN_STAMP_IMAGE=court-seal.png
SIGN_STAMP_OPACITY=0.3

# --- service ----------------------------------------------------------------
HOST=127.0.0.1
PORT=1620
CORS_ALLOW_ORIGINS=*
