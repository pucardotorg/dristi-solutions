# PRODUCTION config -- real DSC token (pkcs11 mode).
# The token PIN is NOT stored here; the app (PIN box) / run.sh prompt for it.
#
# To go back to TEST mode: set SIGNER_MODE=software and comment out the pkcs11
# block (the app then auto-creates a self-signed test-cert.p12).

SIGNER_MODE=pkcs11

# --- pkcs11 (real DSC token) ------------------------------------------------
# Vendor PKCS#11 module for the Hypersecu HYP2003 token (OpenSC does not work).
PKCS11_MODULE_PATH=/home/bhlp0149/Downloads/HYP2003-Linux-x86_64/redist/libcastle_v2.so.1.0.0
# Object labels read from THIS token via: pkcs11-tool --module <so> -O
PKCS11_CERT_LABEL=3dec5b76-5690-4b2e-89fd-9a3e426e88b8
PKCS11_KEY_LABEL=3dec5b76-5690-4b2e-89fd-9a3e426e88b8

# --- software (testing) -- uncomment (and set SIGNER_MODE=software) to test ---
# SIGNER_P12_PATH=test-cert.p12
# SIGNER_P12_PASSWORD=test

# --- service ----------------------------------------------------------------
HOST=127.0.0.1
PORT=1620
CORS_ALLOW_ORIGINS=*
