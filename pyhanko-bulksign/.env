# Testing config (committed) -- software mode, no DSC token needed.
# The app auto-creates a self-signed test cert (test-cert.p12) on first START.
#
# To switch to a REAL DSC token: set SIGNER_MODE=pkcs11 and uncomment the pkcs11
# block below (fill in this machine's module path + labels). The PIN is never
# stored here -- the app / run.sh prompt for it.

SIGNER_MODE=software

# --- software (testing) -----------------------------------------------------
SIGNER_P12_PATH=test-cert.p12
SIGNER_P12_PASSWORD=test

# --- pkcs11 (real DSC token) -- uncomment to use a token --------------------
# SIGNER_MODE=pkcs11
# PKCS11_MODULE_PATH=/home/bhlp0149/Downloads/HYP2003-Linux-x86_64/redist/libcastle_v2.so.1.0.0
# PKCS11_CERT_LABEL=3dec5b76-5690-4b2e-89fd-9a3e426e88b8
# PKCS11_KEY_LABEL=3dec5b76-5690-4b2e-89fd-9a3e426e88b8

# --- service ----------------------------------------------------------------
HOST=127.0.0.1
PORT=1620
CORS_ALLOW_ORIGINS=*
