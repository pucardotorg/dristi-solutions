# Copy to `.env` and fill in for your machine. Do NOT commit a real .env.
# The PIN is best NOT stored here -- pass it interactively (run.sh / run.bat).

# --- Signer backend ---------------------------------------------------------
# software : sign with a .p12 key file (testing, no token)
# pkcs11   : sign with a real DSC USB token via its PKCS#11 module (production)
SIGNER_MODE=pkcs11

# --- pkcs11 (production / real DSC token) -----------------------------------
# The token vendor's PKCS#11 library (NOT OpenSC for Indian DSC tokens). Keep it in
# THIS folder and use a bare filename (resolved next to .env/exe) so the package is
# self-contained; an absolute path also works.
#   Linux (HYP2003): libcastle_v2.so.1.0.0
#   Windows:         <vendor-pkcs11>.dll
PKCS11_MODULE_PATH=libcastle_v2.so.1.0.0
# Cert/key labels: LEAVE BLANK to auto-detect a single-identity token (the app shows
# the detected label under the title). Set explicitly only if the token holds several
# certificates.
PKCS11_CERT_LABEL=
PKCS11_KEY_LABEL=
# PIN: prefer passing at startup (run.sh prompts). Set here only for unattended setups.
# PKCS11_USER_PIN=

# --- software (testing only) ------------------------------------------------
SIGNER_P12_PATH=test-cert.p12
SIGNER_P12_PASSWORD=test

# --- appearance -------------------------------------------------------------
# Visible signature text. %(signer)s = certificate CN, %(ts)s = signing time.
# SIGN_STAMP_TEXT=Digitally signed by %(signer)s\nDate: %(ts)s
# Optional background seal/logo image (PNG/JPG) drawn behind the text, and its
# opacity (0..1; ~0.3 = faint watermark, 1.0 = solid). A bare filename is resolved
# NEXT TO .env / the exe -- just drop court-seal.png in the same folder. Defaults to
# "court-seal.png" (used only if present); set to "" for text-only.
# SIGN_STAMP_IMAGE=court-seal.png
# SIGN_STAMP_OPACITY=0.3

# --- service ----------------------------------------------------------------
HOST=127.0.0.1
PORT=1620
# Restrict CORS to the court web origin(s) in production, e.g.
# CORS_ALLOW_ORIGINS=https://dristi-kerala.pucar.org
CORS_ALLOW_ORIGINS=*
