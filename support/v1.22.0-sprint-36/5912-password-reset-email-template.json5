// Email template for the password reset OTP. The value is a verbatim copy of the
// USER_LOGIN_OTP shell, the wording comes from the notification localization
// message of the same code.
{
  "tenantId": "kl",
  "schemaCode": "mail-template.email-template",
  "uniqueIdentifier": "USER_PASSWORD_RESET_OTP",
  "data": {
    "code": "USER_PASSWORD_RESET_OTP",
    "name": "Password reset Otp for User",
    "value": "<!DOCTYPE html><html><head></head><body><p>{{header}}</p><p>{{message}}</p><p>{{footer}}</p></body></html>"
  },
  "isActive": true
}
