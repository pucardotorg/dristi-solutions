SELECT
    r.role_code,
    'kl' AS role_tenantid,
    u.user_id,
    'kl' AS user_tenantid,
    TIMESTAMP '2026-06-29 20:03:39.908' AS lastmodifieddate
FROM (
    SELECT user_id
    FROM public.eg_userrole_v1
    WHERE role_tenantid = 'kl'
    GROUP BY user_id
    HAVING BOOL_OR(role_code = 'ADVOCATE_CLERK_ROLE')
) u
CROSS JOIN (
    VALUES
        ('PLEA_SIGNER'),
        ('PLEA_EDITOR'),
        ('MEDIATION_SIGNER'),
        ('MEDIATION_EDITOR'),
        ('EXAMINATION_SIGNER'),
        ('EXAMINATION_EDITOR')
) AS r(role_code)
WHERE NOT EXISTS (
    SELECT 1
    FROM public.eg_userrole_v1 e
    WHERE e.user_id = u.user_id
      AND e.role_code = r.role_code
      AND e.role_tenantid = 'kl'
)
ORDER BY u.user_id, r.role_code;

