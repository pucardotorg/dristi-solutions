SELECT DISTINCT ur.user_id
FROM public.eg_userrole_v1 ur
WHERE EXISTS (
    SELECT 1
    FROM public.eg_userrole_v1 adv
    WHERE adv.user_id = ur.user_id
      AND adv.role_code = 'ADVOCATE_CLERK_ROLE'
)
AND NOT EXISTS (
    SELECT 1
    FROM public.eg_userrole_v1 r
    WHERE r.user_id = ur.user_id
      AND r.role_code IN (
          'PLEA_SIGNER',
          'PLEA_EDITOR',
          'MEDIATION_SIGNER',
          'MEDIATION_EDITOR',
          'EXAMINATION_SIGNER',
