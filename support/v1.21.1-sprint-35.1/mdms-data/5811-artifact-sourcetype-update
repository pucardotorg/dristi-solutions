BEGIN;

UPDATE dristi_evidence_artifact ea
SET sourcetype = 'COMPLAINANT'
FROM dristi_cases c
CROSS JOIN LATERAL jsonb_array_elements(
    COALESCE(c.additionaldetails->'advocateDetails'->'formdata','[]'::jsonb)
) f
CROSS JOIN LATERAL jsonb_array_elements(
    COALESCE(f->'data'->'multipleAdvocatesAndPip'->'multipleAdvocateNameDetails','[]'::jsonb)
) adv
WHERE c.id = ea.caseid
  AND ea.sourceid = adv #>> '{advocateBarRegNumberWithName,individualId}'
  AND f #>> '{data,multipleAdvocatesAndPip,boxComplainant,individualId}' IS NOT NULL
  AND LOWER(ea.sourcetype) = 'accused';

  COMMIT;